# ================================================================
# FAMS Backend — Environment Variables
# ================================================================
# Copy this file to .env and fill in the values.
#
# Tag legend:
#   RANDOM   = internal secret; generate a secure random value
#              e.g.:  openssl rand -hex 32
#   REQUIRED = must be set by the project owner before running
#   DEFAULT  = safe to leave as-is for local development
# ================================================================

# ── Database ─────────────────────────────────────────────────────
DB_NAME=fams_db          # DEFAULT
DB_USER=fams_user        # DEFAULT
DB_PASSWORD=             # REQUIRED — set a strong password

# Host/port are set automatically inside Docker (fams-postgres:5432).
# Override only when connecting from outside Docker:
# DB_HOST=localhost
# DB_PORT=5433

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=          # RANDOM — e.g. openssl rand -hex 24

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=              # RANDOM — e.g. openssl rand -hex 32
JWT_ACCESS_TTL_MINUTES=15   # DEFAULT
JWT_REFRESH_TTL_DAYS=30     # DEFAULT

# ── 2FA (Issue #5, docs/issues/ISSUES.md) ─────────────────────────
TOTP_ENCRYPTION_KEY=     # REQUIRED — e.g. openssl rand -hex 32. Encrypts totp_secret at rest.

# ── Expose ports (host-side) ─────────────────────────────────────
DB_EXPOSE_PORT=5433      # DEFAULT
REDIS_EXPOSE_PORT=6379   # DEFAULT
API_EXPOSE_PORT=8080     # DEFAULT

# ── Spring profile ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev   # DEFAULT (change to prod for production)

# ── Email / Google OAuth ─────────────────────────────────────────
OTP_RATE_LIMIT_MAX=10        # DEFAULT — max /auth/otp/verify requests per IP per 15min window
GMAIL_USERNAME=              # REQUIRED — Gmail address for sending emails
GMAIL_APP_PASSWORD=          # REQUIRED — Gmail App Password (not your account password)
GOOGLE_CLIENT_ID=            # REQUIRED — from Google Cloud Console OAuth 2.0 credentials

# ── Firebase / FCM ───────────────────────────────────────────────
# Same Firebase Admin SDK config serves two features, not just push notifications:
# FCM push delivery AND verifying Firebase Phone Auth ID tokens for backlog #2
# (Đăng nhập bằng số điện thoại OTP — see FirebasePhoneTokenVerifier). Leaving
# this unset makes /auth/otp/verify and phone-only registration always return 503.
FCM_PROJECT_ID=              # REQUIRED — Firebase project ID (e.g. fams-8e76a)
FCM_SERVICE_ACCOUNT_JSON=    # REQUIRED — full service account JSON as a single-line string
                             #   Download from: Firebase Console → Project Settings
                             #   → Service Accounts → Generate new private key
                             #   Minify the JSON and paste it here (keep \n in private_key)

# ── Frontend / API origin (emailed links) ─────────────────────────
# APP_BASE_URL: this backend's OWN origin (TOTP QR and service-generated API URLs).
# APP_FRONTEND_URL: the WEB APP origin for every token link a human opens: password
# reset, registration verification and profile-email confirmation. Legacy links that
# still point directly at the backend are redirected to this frontend before their
# one-time token is consumed.
# Khi đổi Wi-Fi trong workspace FAMS, chạy `npm run sync:lan` tại front-app để cập
# nhật đồng thời app/web/backend; không cần sửa từng file bằng tay.
APP_BASE_URL=http://localhost:8080          # DEV DEFAULT — this API server's own origin
APP_FRONTEND_URL=http://localhost:3000      # DEV DEFAULT — set to the deployed web/app URL in staging/production

# ── AI service (Face ID / liveness) ──────────────────────────────
# AI_INTERNAL_SECRET has NO default in application.yml — the API will fail
# to start without it, even if you're only running the Java-only stack and
# never call the Face ID endpoints.
AI_INTERNAL_SECRET=          # REQUIRED — e.g. openssl rand -hex 32 (shared secret with the AI service)

# ── Object storage (Issue #4, docs/issues/ISSUES.md — avatar uploads) ────────────
# Dev: leave as-is to use the bundled MinIO container (docker-compose.dev.yml).
# Production: leave S3_ENDPOINT empty and set real AWS credentials/bucket/region instead
# — AvatarStorageService talks to either through the same S3-compatible client code.
S3_ENDPOINT=http://fams-minio:9000   # DEV DEFAULT — empty in production (uses real AWS S3)
S3_REGION=us-east-1                 # DEFAULT
S3_BUCKET=fams-avatars               # DEFAULT — real deployments should use their own bucket name
S3_ACCESS_KEY=fams_minio_admin       # DEV DEFAULT — use a real IAM access key in production
S3_SECRET_KEY=fams_minio_secret      # DEV DEFAULT — use a real IAM secret key in production
S3_PUBLIC_URL=http://localhost:9000/fams-avatars   # DEV DEFAULT — your bucket's public URL/CDN domain in production
MINIO_EXPOSE_PORT=9000               # DEFAULT
MINIO_CONSOLE_EXPOSE_PORT=9001       # DEFAULT

# CORS — only needed for browser-based cross-origin clients (Expo web dev server,
# LAN-IP origins for testing Expo web from another device). Native apps and the Web
# Admin (same-origin via Next.js proxy) are unaffected.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*   # DEV DEFAULT — restrict to real origins in production
