@startuml FAMS_System_Overview
title FAMS — Use Case tổng quan (Mức 1)
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Người dùng" as Guest
actor "Người dùng\nđã xác thực" as User
actor "Platform Admin" as PA
actor "Platform Staff" as PS
actor "Tenant Admin / Owner" as TA
actor "HR Manager" as HR
actor "Site Supervisor" as SS
actor "Employee" as EE

PA --|> User
PS --|> User
TA --|> User
HR --|> User
SS --|> User
EE --|> User

actor "Google Identity" as Google <<external system>>
actor "Firebase" as Firebase <<external system>>
actor "Dịch vụ Email" as Mail <<external system>>
actor "Object Storage" as Storage <<external system>>

rectangle "HỆ THỐNG FAMS" {
  usecase "Quản lý tài khoản\nvà xác thực" as UCAuth
  usecase "Quản trị nền tảng\nvà tenant" as UCPlatform
  usecase "Quản lý vai trò\nvà quyền" as UCRbac
  usecase "Quản lý tổ chức\nvà nhân sự" as UCWorkforce
  usecase "Quản lý site, geofence,\nca và phân công" as UCScheduling
  usecase "Quản lý Face ID" as UCFace
  usecase "Chấm công và\nquản lý bảng công" as UCAttendance
  usecase "Kiểm tra ngẫu nhiên\nvà xử lý vi phạm" as UCRandom
  usecase "Theo dõi dashboard\nvà lập báo cáo" as UCReporting
  usecase "Quản lý và nhận\nthông báo" as UCNotify
  usecase "Tra cứu audit và\ntrạng thái hệ thống" as UCOps
}

Guest --> UCAuth
User --> UCAuth
User --> UCNotify

PA --> UCPlatform
PA --> UCRbac
PA --> UCOps
PS --> UCPlatform : theo quyền được cấp
PS --> UCOps : theo quyền được cấp

TA --> UCPlatform
TA --> UCRbac
TA --> UCWorkforce
TA --> UCScheduling
TA --> UCFace
TA --> UCAttendance
TA --> UCRandom
TA --> UCReporting
TA --> UCOps : audit tenant

HR --> UCWorkforce
HR --> UCScheduling
HR --> UCFace
HR --> UCAttendance
HR --> UCRandom
HR --> UCReporting
HR --> UCOps : audit theo quyền

SS --> UCScheduling : chỉ đọc theo site
SS --> UCAttendance : theo site được giao
SS --> UCRandom : theo site được giao
SS --> UCReporting : dashboard/báo cáo site

EE --> UCFace
EE --> UCAttendance
EE --> UCRandom
EE --> UCReporting : dữ liệu cá nhân

Google --> UCAuth
Firebase --> UCAuth
Firebase --> UCNotify
Mail --> UCAuth
Mail --> UCNotify
Storage --> UCFace
Storage --> UCRandom
Storage --> UCAuth : ảnh đại diện

note bottom of UCPlatform
  Platform Staff và vai trò platform tùy biến
  chỉ có năng lực tương ứng permission thực tế.
end note
@enduml
